        "# Preprocessing and train-test split\n",
        "This section prepares the dataset for modelling. The input matrix has 14,445 samples and 21 features. I remove invalid values such as NaN and infinite values, then split the cleaned data into training and testing sets. I also scale the input features so that the models are not affected too much by differences in feature magnitude."
      ],
      "metadata": {
        "id": "jXCr44P7VIKJ"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Create simple feature names\n",
        "feature_names = [f\"Feature{i}\" for i in range(input_features.shape[1])]\n",
        "\n",
        "# Convert the input data to numpy arrays\n",
        "X = np.array(input_features)\n",
        "y = np.array(target_variables)\n",
        "\n",
        "# Remove rows with NaN or infinite values\n",
        "valid_mask = np.isfinite(X).all(axis=1) & np.isfinite(y)\n",
        "\n",
        "X_clean = X[valid_mask]\n",
        "y_clean = y[valid_mask]\n",
        "\n",
        "print(\"Original X shape:\", X.shape)\n",
        "print(\"Cleaned X shape:\", X_clean.shape)\n",
        "print(\"Cleaned y shape:\", y_clean.shape)\n",
        "\n",
        "# Split the data into training and testing sets\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X_clean,\n",
        "    y_clean,\n",
        "    test_size=0.25,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "# Scale the input features\n",
        "scaler = StandardScaler()\n",
        "\n",
        "X_train_scaled = scaler.fit_transform(X_train)\n",
        "X_test_scaled = scaler.transform(X_test)\n",
        "\n",
        "print(\"Training data shape:\", X_train_scaled.shape)\n",
        "print(\"Testing data shape:\", X_test_scaled.shape)"
      ],
