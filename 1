      "cell_type": "markdown",
      "source": [
        "# Explainable AI using polynomial regression coefficients\n",
        "This section uses polynomial regression to check which features have stronger influence on the roughness prediction. I use a second-degree polynomial model because it can include simple non-linear relationships between the input features. The feature importance is estimated from the absolute model coefficients. Larger coefficient values suggest that the feature has a stronger effect in this model."
      ],
      "metadata": {
        "id": "7mOpUqSwVR7Z"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.preprocessing import PolynomialFeatures\n",
        "from sklearn.linear_model import Ridge\n",
        "\n",
        "# Build polynomial features\n",
        "poly = PolynomialFeatures(\n",
        "    degree=2,\n",
        "    include_bias=False\n",
        ")\n",
        "\n",
        "X_train_poly = poly.fit_transform(X_train_scaled)\n",
        "X_test_poly = poly.transform(X_test_scaled)\n",
        "\n",
        "# Use Ridge regression to make the polynomial model more stable\n",
        "poly_model = Ridge(alpha=1.0)\n",
        "poly_model.fit(X_train_poly, y_train)\n",
        "\n",
        "# Predict using the polynomial model\n",
        "y_pred_poly = poly_model.predict(X_test_poly)\n",
        "\n",
        "# Calculate performance\n",
        "mse_poly = mean_squared_error(y_test, y_pred_poly)\n",
        "rmse_poly = np.sqrt(mse_poly)\n",
        "r2_poly = r2_score(y_test, y_pred_poly)\n",
        "\n",
        "print(\"Polynomial regression model using all features\")\n",
        "print(\"MSE:\", mse_poly)\n",
        "print(\"RMSE:\", rmse_poly)\n",
        "print(\"R²:\", r2_poly)"
      ],
