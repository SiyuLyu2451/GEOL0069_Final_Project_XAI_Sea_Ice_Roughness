    {
      "cell_type": "markdown",
      "source": [
        "The polynomial model creates extra interaction features, so I group the coefficient values back to the original 21 input features. This gives one importance score for each original feature."
      ],
      "metadata": {
        "id": "Ke67hLeEcPZq"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import re\n",
        "\n",
        "# Get polynomial feature names\n",
        "poly_feature_names = poly.get_feature_names_out(feature_names)\n",
        "\n",
        "# Get absolute coefficient values\n",
        "poly_coefficients = np.abs(poly_model.coef_)\n",
        "\n",
        "# Sum coefficient values back to each original feature\n",
        "# This method also catches squared terms such as Feature1^2\n",
        "poly_importance = {}\n",
        "\n",
        "for feature in feature_names:\n",
        "    total_importance = 0\n",
        "\n",
        "    for poly_name, coefficient in zip(poly_feature_names, poly_coefficients):\n",
        "        involved_features = re.findall(r\"Feature\\d+\", poly_name)\n",
        "\n",
        "        if feature in involved_features:\n",
        "            total_importance += coefficient\n",
        "\n",
        "    poly_importance[feature] = total_importance\n",
        "\n",
        "# Convert to dataframe\n",
        "poly_importance_df = pd.DataFrame({\n",
        "    \"Feature\": list(poly_importance.keys()),\n",
        "    \"Importance\": list(poly_importance.values())\n",
        "})\n",
        "\n",
        "poly_importance_df = poly_importance_df.sort_values(\"Importance\", ascending=False)\n",
        "\n",
        "print(poly_importance_df)"
      ],
